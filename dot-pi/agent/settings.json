    "npm:pi-mcp-adapter",
    "npm:pire-browser",
    {
      "source": "npm:@robhowley/pi-openrouter",
      "extensions": [
        "-extensions/openrouter/index.ts"
      ]
    },
    "npm:pi-beads-extension",
    "npm:@tintinweb/pi-tasks",
    "npm:@tintinweb/pi-subagents",
    "npm:@feniix/pi-sequential-thinking",
    "npm:pi-stop",
    "npm:pi-safe-compact",
    {
      "source": "npm:@agnishc/edb-context-viewer",
      "extensions": [
        "+src/index.ts"
      ]
    },
    "npm:@fgladisch/pi-persistent-history",
    "npm:pi-quiet-tools",
    "npm:pi-context-cap",
    "npm:@djhaskin987/pi-top-of-mind",
