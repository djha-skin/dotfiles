#!/bin/sh

bisync() {
    rclone bisync "${@}"
    if [ "${?}" = 2 -o "${?}" = 7 ]
    then
        rclone bisync "${@}" --resync
    fi
}

. ${HOME}/.profile
(
    flock -n 9
    if [ "${?}" -ne 0 ]
    then
        echo "Another instance is running." >&2
        exit 0
    fi
    bisync OneDrive:/Markdown/ ${HOME}/OneDrive/Markdown/
    bisync OneDrive:/KeePassXC/ ${HOME}/OneDrive/KeePassXC/
    bisync OneDrive:/Documents/ ${HOME}/OneDrive/Documents/
    bisync OneDrive:/Books/ ${HOME}/OneDrive/Books/
    bisync OneDrive:/Audio/ ${HOME}/OneDrive/Audio/
) 9>~/.cache/onedrive-sync-lock