#!/bin/sh

# New tmux panes are not ready to consume terminal input immediately.  Launch
# commands as the pane's process rather than injecting keys during shell setup.
# The final Bash keeps the pane available after a command exits.
run_in_pane() {
    tmux "${1}" \
        "exec /opt/homebrew/bin/bash -isc \"${2}\""
}

usage() {
    echo "Usage: start-my-day [-r|--reset]" >&2
    echo "  -p, --play     After-hours mode" >&2
    echo "  -v, --vpn      Connect to the VPN" >&2
    echo "  -r, --reset    Reset the environment before starting" >&2
    echo "  -h, --help     Display this help message" >&2
    exit 1
}

if [ -f "${HOME}/.private_shell_aliases" ]; then
    source ~/.private_shell_aliases
fi

reset=0
play=0
vpn=0
timer=1
while [ -n "${1}" ]
do
    case "${1}" in
        -r|--reset)
            reset=1
            shift
            ;;
        -t|--timer)
            timer=1
            shift
            ;;
        -T|--no-timer)
            timer=0
            shift
            ;;
        -v|--vpn)
            vpn=1
            shift
            ;;
        -p|--play)
            play=1
            timer=0
            shift
            ;;
        -h|--help)
            shift
            usage
            ;;
        *)
            echo "Unknown option: ${1}" >&2
            shift
            ;;
    esac
done

if [ -z "${PROFILE_INCLUDED}" ]
then
    . ~/.profile
fi

if [ "${reset}" -eq 1 ]
then
    pcleard
fi

tmux rename-window "Background"
tmux send-keys -t :.0 "scrcpy" Enter

if [ "${play}" -ne 0 ]
then
    run_in_pane new-window "cd ~/OneDrive/Markdown/Home && diary"
else
    run_in_pane new-window "cd ~/OneDrive/Markdown/Work && diary"
fi
if [ "${timer}" -ne 0 ]
then
    run_in_pane split-window "timer Blast 22 && timer Pacer 2 && timer Shutdown 1 && timer Break 5"
fi
tmux rename-window "Planner"

run_in_pane new-window "exec neomutt -F ~/.mutt/mhome.account -e 'push <0><d>'"
if [ "${play}" -eq 0 ]
then
    run_in_pane split-window "exec neomutt -F ~/.mutt/mwork.account -e 'push <O><d>'"
else
    run_in_pane split-window "exec neomutt -F ~/.mutt/mmigadu.account -e 'push <O><d>'"
fi
tmux select-layout even-vertical
tmux rename-window "Email"

run_in_pane new-window "exec khal interactive"
tmux rename-window "Calendar"
run_in_pane new-window "exec irssi"
tmux rename-window "Chat"
#tmux split-window
#tmux send-keys -t :.2 "cd ~" Enter "nchat" Enter
#tmux select-layout even-vertical
#tmux new-window
#tmux rename-window "System"
#tmux send-keys -t :.0 "btop" Enter
run_in_pane new-window "exec newsboat --refresh-on-start"
tmux rename-window "News"
tmux new-window
tmux rename-window "Lab"
